# Copy to .env locally. Never commit .env.
# Resolve application only. ChatGPT / Cursor / Codex are not runtime deps.

# Local Mongo (Coder 1 owns process; Coder 3 owns persistence)
RESOLVE_MONGO_URI=mongodb://127.0.0.1:27017
RESOLVE_MONGO_DB=resolve

# Local OpenAI-compatible Qwen on GB10 (do not point this at a cloud LLM)
LOCAL_OPENAI_COMPATIBLE_ENDPOINT=http://127.0.0.1:8000/v1
RESOLVE_MODEL_ALIAS=qwen3.8-resolve

# Resolve HTTP must not share the vLLM port.
# vLLM: 127.0.0.1:8000
# Resolve: 127.0.0.1:8080
RESOLVE_HOST=127.0.0.1
RESOLVE_PORT=8080
